# ==============================================
# LatextAI Backend — Environment Variables
# ==============================================
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the values.

# --- Application URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb://admin:password@localhost:27017/latext_db?authSource=admin

# --- Security & JWT ---
SECRET_KEY=your-secret-key
JWT_SECRET_KEY=your-jwt-secret-key
EMAIL_VERIFICATION_SALT=your-email-salt
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=604800

# --- Email Service (Brevo) ---
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@latext.ai
BREVO_SENDER_NAME=Latext.ai
VERIFICATION_BASE_URL=http://localhost:8000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- LatextAI Pipeline Service ---
LATEXTAI_SERVICE_URL=http://localhost:8001
LATEXTAI_SERVICE_URL_FAST=
LATEXTAI_API_KEY=your-latextai-api-key

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SCHOLAR=price_...
STRIPE_PRICE_RESEARCHER=price_...
STRIPE_PRICE_PROFESSOR=price_...

# --- reCAPTCHA ---
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# --- File Storage ---
ADMIN_IMAGES_DIR=./images
