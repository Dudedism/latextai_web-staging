# Exclude generic .env file (local development)
# But INCLUDE environment-specific files (.env.staging, .env.production, .env.development)
# These are needed by the Dockerfile COPY command
.env
!.env.staging
!.env.production
!.env.development

# Exclude build artifacts
dist
node_modules

# Exclude development files
.vscode
.idea
*.log
npm-debug.log*

# Exclude git
.git
.gitignore

# Exclude Docker files
Dockerfile
docker-compose.yml
.dockerignore
